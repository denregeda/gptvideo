# Секреты — НИКОГДА в репозиторий
.env
.env.stage
.env.prod

# Python-кэш и байткод
__pycache__/
*.pyc
*.pyo

# Celery
celerybeat-schedule
celerybeat.pid

# Резервные копии и архивы проекта (хранятся вне репозитория)
backups/

# Временные и служебные файлы
*.bak
*.save
*.tmp
*.swp

# Артефакты ОС
.DS_Store
Thumbs.db

# Логи
*.log

# Служебные файлы локальных агентов
.claude/
.codex/
.agents/

# Диагностические отчёты (создаются collect_diag*.sh)
diag_*.txt

# Локальный удостоверяющий центр и TLS-сертификаты создаются на сервере.
# Приватные ключи никогда не должны попадать в git.
tls/generated/
