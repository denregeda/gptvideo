# Пример структуры. Рабочий .env автоматически создаёт install_server.sh.
# Не используйте значения-заглушки в production.
POSTGRES_DB=display_system
POSTGRES_USER=display_user
DB_PASSWORD=<случайная_строка_не_менее_32_символов>
MINIO_USER=ds_minio
MINIO_PASSWORD=<случайная_строка_не_менее_32_символов>
SECRET_KEY=<случайный_ключ_не_менее_32_символов>

# Ограничение неудачных входов в одном 15-минутном окне.
AUTH_ACCOUNT_FAILURE_LIMIT=5
AUTH_IP_FAILURE_LIMIT=20
AUTH_FAILURE_WINDOW_SECONDS=900

# TLS создаётся автоматически локальным CA. Укажите стабильное имя сервера
# и дополнительные DNS/IP через запятую, если агенты обращаются не по IP хоста.
TLS_SERVER_NAME=display.local
TLS_EXTRA_SANS=
TLS_RENEW_DAYS=30
# true — старые агенты временно работают по HTTP; false — весь HTTP → HTTPS.
TLS_LEGACY_HTTP=true
